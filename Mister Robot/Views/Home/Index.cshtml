@{
   Layout = null;
}

<!DOCTYPE html>

<html lang="en">

<head>

   <meta charset="UTF-8" />

   <meta name="viewport"
         content="width=device-width, initial-scale=1.0" />

   <title>@ViewData["Title"]</title>

   <meta name="description"
         content="@ViewData["MetaDescription"]" />

   <meta name="keywords"
         content="@ViewData["MetaKeywords"]" />

   <link rel="icon"
         type="image/png"
         href="@Url.Content("~/assets/mr_robot_logo.webp")" />

   <link rel="stylesheet"
         href="@Url.Content("~/css/navbar.css")" />

   <link rel="stylesheet"
         href="@Url.Content("~/css/homepage.css")" />

</head>


<body>

   <header class="header-nav">

      <a href="@Url.Action("Index", "Home")"
         class="logo">

         <img src="@Url.Content("~/assets/mr_robot_logo.webp")"
              alt="Mr. Robot Logo" />

      </a>


      <nav class="navbar">

         <a href="@Url.Action("Index", "Home")"
            class="nav-link active">

            <i class="nav-icon">

               <img src="@Url.Content("~/assets/boxicons/bx-home-heart.svg")"
                    alt="home icon" />

            </i>

            Home

         </a>


         <a href="@Url.Action("Index", "Inventory")"
            class="nav-link">

            <i class="nav-icon">

               <img src="@Url.Content("~/assets/boxicons/bx-box.svg")"
                    alt="inventory icon" />

            </i>

            Inventory

         </a>


         <a href="@Url.Action("Index", "Cart")"
            class="nav-link">

            <i class="nav-icon">

               <img src="@Url.Content("~/assets/boxicons/cart-regular-24.svg")"
                    alt="cart icon" />

            </i>

            Cart

         </a>


         <a href="@Url.Action("Index", "Wishlist")"
            class="nav-link">

            <i class="nav-icon">

               <img src="@Url.Content("~/assets/boxicons/bx-heart-circle.svg")"
                    alt="wishlist icon" />

            </i>

            Wishlist

         </a>


         <a href="@Url.Action("Index", "Order")"
            class="nav-link">

            <i class="nav-icon">

               <img src="@Url.Content("~/assets/boxicons/bx-doughnut-chart.svg")"
                    alt="orders icon" />

            </i>

            Orders

         </a>


         <a href="@Url.Action("Index", "Contact")"
            class="nav-link">

            <i class="nav-icon">

               <img src="@Url.Content("~/assets/boxicons/contact-solid-24.svg")"
                    alt="contact icon" />

            </i>

            Contact

         </a>


         @if (User.Identity?.IsAuthenticated == true)
         {
            <a href="@Url.Action("Index", "ContactMessage")"
               class="nav-link">

               <i class="nav-icon">

                  <img src="@Url.Content("~/assets/boxicons/message-rounded-regular-24.svg")"
                       alt="messages icon" />

               </i>

               Your Messages

            </a>
         }


         @if (User.IsInRole("Admin"))
         {
            <a href="@Url.Action("Index", "Admin")"
               class="nav-link">

               <i class="nav-icon">

                  <img src="@Url.Content("~/assets/boxicons/dashboard-solid-24.svg")"
                       alt="dashboard icon" />

               </i>

               Admin Panel

            </a>
         }


         @if (User.Identity?.IsAuthenticated == true)
         {
            <a href="@Url.Page(
                                           "/Account/Manage/Index",
                                           new { area = "Identity" })"
               class="nav-link">

               <i class="nav-icon">

                  <img src="@Url.Content("~/assets/boxicons/bx-cog.svg")"
                       alt="settings icon" />

               </i>

               Settings

            </a>
         }

      </nav>


      <partial name="_LoginPartial" />

   </header>



   <main class="showcase">

      <video class="background-video"
             autoplay
             loop
             muted
             playsinline>

         <source src="@Url.Content("~/assets/background/bg_world_loop.mp4")"
                 type="video/mp4" />

      </video>


      <section class="content">

         <div class="hero-badge">
            Hardware • Components • Accessories
         </div>


         <h1 class="main-title">

            Hi, I'm

            <span class="highlight">
               Mr. Robot
            </span>

         </h1>


         <p class="sub-title">

            Your place for hardware,
            components and accessories.

         </p>


         <p class="page-type">

            Discover the right

            <span class="highlight">
               CPUs
            </span>,

            <span class="highlight">
               GPUs
            </span>

            and accessories
            for your next setup.

         </p>


         <div class="hero-actions">

            <a href="@Url.Action("Index", "Inventory")"
               class="btn-explore">

               Explore Inventory

            </a>


            <a href="@Url.Action("Index", "Contact")"
               class="btn-contact">

               Contact Us

            </a>

         </div>


         <div class="hero-features">

            <div class="hero-feature">

               <span class="hero-feature-icon">
                  ✓
               </span>

               PC Components

            </div>


            <div class="hero-feature">

               <span class="hero-feature-icon">
                  ✓
               </span>

               Accessories

            </div>


            <div class="hero-feature">

               <span class="hero-feature-icon">
                  ✓
               </span>

               Wishlist & Cart

            </div>

         </div>

      </section>

   </main>

</body>

</html>